# 카카오 개발자 콘솔(https://developers.kakao.com) → 내 애플리케이션 → 앱 키 → JavaScript 키.
# 같은 콘솔의 [앱 설정 → 플랫폼 → Web]에 http://localhost:3030 을 등록해야 지도가 뜬다.
# 이 파일을 .env.local로 복사해 값을 채운 뒤 dev 서버를 재시작할 것 (빌드 타임에 인라인됨).
NEXT_PUBLIC_KAKAO_MAP_KEY=

# Supabase 프로젝트(cagongmap)의 URL과 publishable key.
# 대시보드 → Project Settings → API Keys에서 확인. 서버 전용이라 NEXT_PUBLIC 접두사 없음.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
